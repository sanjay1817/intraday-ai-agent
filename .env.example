# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable here is read by app/config/settings.py — keep the two in sync.

# --- Application ---
APP_NAME="Intraday Trading Agent"
# One of: development, testing, staging, production
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=intraday_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intraday_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# true = structured JSON logs (production); false = human-readable console logs (development)
LOG_JSON=false
# Directory for the dated buy/sell trade log (one file per day, e.g. trades-2026-08-06.log)
TRADE_LOG_DIR=logs/trades

# --- Scheduler ---
SCHEDULER_TIMEZONE=UTC
SCHEDULER_ENABLED=true

# --- Brokers ---
# Which configured broker below `get_broker_adapter` uses by default.
# One of: angel_one, upstox, zerodha
DEFAULT_BROKER=angel_one

# Automatically call login() on the resolved broker during app startup.
# Only takes effect when that broker is Angel One (SmartAPI's password+TOTP
# login is programmatic and safe to repeat); Zerodha/Upstox are never
# auto-logged-in since their tokens are single-use browser tokens. Turn
# this on for unattended deployments (e.g. AWS) where nobody would
# otherwise call login() after each restart.
AUTO_LOGIN_ON_STARTUP=false

# Shared HTTP behavior for every broker adapter (app/brokers).
BROKER__REQUEST_TIMEOUT_SECONDS=10
BROKER__MAX_RETRIES=3
BROKER__RETRY_BACKOFF_SECONDS=0.5
BROKER__RETRY_MAX_BACKOFF_SECONDS=8

# Angel One SmartAPI (https://smartapi.angelbroking.com/docs)
# totp_secret is the base32 secret used to generate login TOTPs, not a one-time code.
BROKER__ANGEL_ONE__CLIENT_CODE=
BROKER__ANGEL_ONE__PASSWORD=
BROKER__ANGEL_ONE__TOTP_SECRET=
BROKER__ANGEL_ONE__API_KEY=
BROKER__ANGEL_ONE__BASE_URL=https://apiconnect.angelbroking.com

# Upstox (https://upstox.com/developer/api-documentation)
# auth_code is the one-time OAuth "code" from the browser redirect; there is
# no programmatic refresh, so this must be re-populated whenever it expires.
BROKER__UPSTOX__API_KEY=
BROKER__UPSTOX__API_SECRET=
BROKER__UPSTOX__REDIRECT_URI=
BROKER__UPSTOX__AUTH_CODE=
BROKER__UPSTOX__BASE_URL=https://api.upstox.com/v2

# Zerodha Kite Connect (https://kite.trade/docs/connect/v3/)
# request_token is the one-time token from the browser login redirect; only
# "extended" Kite Connect apps get a refresh_token, so standard apps must
# re-populate this whenever the access token expires.
BROKER__ZERODHA__API_KEY=
BROKER__ZERODHA__API_SECRET=
BROKER__ZERODHA__REQUEST_TOKEN=
BROKER__ZERODHA__BASE_URL=https://api.kite.trade

# --- Options (Phase 1 infrastructure) ---
# Infrastructure only in this phase: no order placement reads these yet.
# One of: EQUITY, OPTIONS. Reserved for a future phase that routes orders
# through options.
TRADING_MODE=EQUITY

# Underlyings app.options.OptionChainService fetches/caches option chains
# for (a JSON array, same format as AUTO_SYMBOLS).
OPTION_UNDERLYINGS=["NIFTY","BANKNIFTY","FINNIFTY"]

# Default strike-selection mode. One of: ATM, ITM, OTM.
OPTION_STRIKE_MODE=ATM

# Default expiry-selection mode. One of: NEAREST_WEEKLY, NEXT_WEEKLY, MONTHLY.
OPTION_EXPIRY_MODE=NEAREST_WEEKLY

# How long (seconds) a cached option chain is considered fresh before
# OptionChainService re-fetches it from the broker.
OPTION_CHAIN_REFRESH_SECONDS=30

# --- Options Paper Trading (Phase 3) ---
# Fallback lot size used only when the live chain's own OptionInstrument.lot_size
# is unavailable. The chain's broker-sourced lot size is always preferred.
OPTION_DEFAULT_LOT_SIZE=50

# Maximum lots a single paper option order may request.
OPTION_MAX_LOTS_PER_ORDER=10

# Maximum premium value (quantity * premium) a single paper option order may commit.
OPTION_MAX_PREMIUM_PER_ORDER=50000

# Maximum total premium value across every open option position at once.
OPTION_MAX_PREMIUM_EXPOSURE=200000

# Maximum realized option P&L loss for one IST trading day before further
# paper option entries are locked out. Independent of MAX_DAILY_LOSS (Auto Trading).
OPTION_MAX_DAILY_LOSS=10000

# --- Auto Options Trading (Phase 5) ---
# Whether AutoOptionsOrchestrator starts automatically at process startup.
# Only takes effect when TRADING_MODE=OPTIONS. POST /api/v1/options/auto/start
# can start it at runtime either way.
AUTO_OPTIONS_ENABLED=false

# IST wall-clock time (HH:MM) at/after which every open paper option position
# the orchestrator is tracking is force-exited, regardless of premium.
AUTO_OPTION_EXIT_TIME=15:20

# Maximum simultaneously open option positions the orchestrator itself will hold.
AUTO_MAX_OPEN_OPTION_POSITIONS=3

# How often (seconds) the orchestrator scans underlyings and re-checks exits.
AUTO_OPTION_SCAN_INTERVAL_SECONDS=30

# Minimum OptionRecommendation.confidence the orchestrator acts on for a new entry.
AUTO_OPTION_CONFIDENCE_THRESHOLD=60

# Minimum number of Strategy Engine strategies that must agree before the
# orchestrator acts on a new entry (2 of the 3 registered strategies by default).
AUTO_OPTION_MIN_CONFIRMATIONS=2

# Fixed lot count requested for every auto-entered position.
AUTO_OPTION_LOTS_PER_TRADE=1

# Percentage of entry premium below which a tracked position is stopped out.
AUTO_OPTION_STOP_LOSS_PERCENT=30

# Percentage of entry premium above which a tracked position hits its target.
AUTO_OPTION_TARGET_PERCENT=50
